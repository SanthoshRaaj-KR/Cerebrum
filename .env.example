# Copy this file to .env and fill in your keys.
#
# Three keys are needed: one for the LLM (whichever provider config.yaml's
# interviewer.provider selects), Deepgram (covers both speech-to-text and
# text-to-speech off a single key), and Tavily (grounds the interview's
# questions in what's actually asked for the candidate's target role).

# Deepgram - hears your answers AND speaks the questions. Always required.
# console.deepgram.com
DEEPGRAM_API_KEY=

# Tavily - researches the candidate's target role before the interview
# starts, so questions are grounded in what's actually asked and actually
# required rather than the model's own guess. Required unless
# research.enabled is set to false in config.yaml, or you rely on Brave
# below instead. tavily.com
TAVILY_API_KEY=

# Brave Search - optional fallback for that same role research, used only
# when Tavily is unreachable or rate-limited (or in place of it, if you
# list only brave under research.providers in config.yaml). Free tier at
# api-dashboard.search.brave.com
BRAVE_API_KEY=

# --- the interviewer's brain: fill in whichever provider you selected ---

# OpenAI - the default (interviewer.provider: openai). platform.openai.com/api-keys
OPENAI_API_KEY=

# Cerebras - much faster, which matters for a spoken interview. Set
# interviewer.provider to cerebras in config.yaml to use it. cloud.cerebras.ai
# Note: the account needs credit, not just a valid key - listing models works
# on an unfunded account, but completions return 402. `-Check` catches this.
CEREBRAS_API_KEY=

# --- optional: keep your interviews ---

# MongoDB - where a finished interview goes when you press Store, so you
# can reopen it later and see your progress across rounds. Leave it blank
# and everything still works; you just lose each interview when you close
# the tab. Atlas and a local mongod both work - it is only a URI:
#   Atlas  mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/
#   local  mongodb://127.0.0.1:27017/
MONGODB_URI=
