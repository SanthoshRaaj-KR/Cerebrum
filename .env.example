# Copy this file to .env and fill in your keys.
#
# Only the two below are required. Deepgram covers both speech-to-text and
# text-to-speech off the same key, so there's no third account to hold.

# Cerebras - the interviewer's brain (LLM). cloud.cerebras.ai
# The account needs credit, not just a valid key: listing models works on an
# unfunded account, but running an interview returns 402. `-Check` catches it.
CEREBRAS_API_KEY=

# Deepgram - hears your answers AND speaks the questions. console.deepgram.com
DEEPGRAM_API_KEY=

# Cartesia - OPTIONAL. Only needed if you set voice.tts.provider to cartesia
# in config.yaml, to use its voices instead of Deepgram's. play.cartesia.ai
CARTESIA_API_KEY=
