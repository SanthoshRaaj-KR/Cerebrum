# Copy this file to .env and fill in your keys.

# Cerebras - the interviewer's brain (LLM). console.cerebras.ai
CEREBRAS_API_KEY=

# Deepgram - speech to text (hears your spoken answers). console.deepgram.com
DEEPGRAM_API_KEY=

# Cartesia - text to speech (the interviewer's voice). play.cartesia.ai
CARTESIA_API_KEY=
